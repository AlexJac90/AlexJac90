{
  "name": "Shopping List (PHP + MariaDB)",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "install": "php -v && echo 'No dependency install required (plain PHP app).'",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "php-server",
      "command": "php -S 0.0.0.0:8000 -t ."
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 8000
    }
  ]
}
